<mxCell id="noteFares" value="&lt;b&gt;Fares and shares are calculated, not stored (FR15)&lt;/b&gt;&lt;br&gt;estimatedFare() = rideOption.baseFare + rideOption.perMileRate ×&lt;br&gt;    meetingPoint.distanceTo(destination), rounded to the dollar (US8)&lt;br&gt;estimatedShare() = estimatedFare / (organizer + accepted riders + viewer)&lt;br&gt;finalShare() = finalFare / (organizer + accepted riders), to the cent (US17)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;fillColor=#FFF8DC;strokeColor=#B8A24A;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="440" height="120" as="geometry"/></mxCell>
<mxCell id="noteValues" value="&lt;b&gt;Values used by the user stories&lt;/b&gt;&lt;br&gt;Ride.status: open | full | cancelled | completed&lt;br&gt;RideRequest.status: pending | accepted | declined | withdrawn&lt;br&gt;Location.kind: airport | bus station | event venue | other&lt;br&gt;Notification.type: request received | request accepted |&lt;br&gt;    request declined | ride changed | ride cancelled | reminder&lt;br&gt;&lt;font color=&quot;#1a56c4&quot;&gt;RideOption.name: UberX | UberXL | Lyft Standard | Lyft XL&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;fillColor=#FFF8DC;strokeColor=#B8A24A;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="420" height="160" as="geometry"/></mxCell>
<mxCell id="noteChanges" value="&lt;b&gt;Changes since Sprint 2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1a56c4&quot;&gt;Blue = added or changed since Sprint 2&lt;/font&gt;&lt;br&gt;Removed (future work, FR17–FR19): Report class,&lt;br&gt;RideBoard.usageTotals(), User.role,&lt;br&gt;User.accountStatus, Ride.rideOption (attribute)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;fillColor=#FFF8DC;strokeColor=#B8A24A;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="340" height="120" as="geometry"/></mxCell>
