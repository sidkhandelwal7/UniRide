<mxCell id="c2" value="«layer» Presentation" style="shape=folder;fontStyle=1;spacingTop=8;tabWidth=161;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;fillColor=#F4F6FA;strokeColor=#8A96A3;fontColor=#3c4a59;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1160" height="160" as="geometry"/></mxCell>
<mxCell id="c3" value="«layer» Application" style="shape=folder;fontStyle=1;spacingTop=8;tabWidth=152;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;fillColor=#F4F6FA;strokeColor=#8A96A3;fontColor=#3c4a59;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1160" height="470" as="geometry"/></mxCell>
<mxCell id="c4" value="«layer» Data" style="shape=folder;fontStyle=1;spacingTop=8;tabWidth=106;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;fillColor=#F4F6FA;strokeColor=#8A96A3;fontColor=#3c4a59;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1160" height="200" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;font color=&quot;#555555&quot;&gt;«client»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Student&amp;#x27;s web browser&lt;/b&gt;&lt;br&gt;Phone or laptop; HTML pages over HTTPS&lt;br&gt;Opens the Uber / Lyft link at pickup (US6)" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#F7F7F7;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;font color=&quot;#555555&quot;&gt;«external»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Uber / Lyft app&lt;/b&gt;&lt;br&gt;Books the ride; opened with pickup&lt;br&gt;and drop-off prefilled (FR16, C1)" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#F7F7F7;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="1260" y="30" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;font color=&quot;#555555&quot;&gt;«external»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Map Service&lt;/b&gt;&lt;br&gt;Map for two coordinates (FR14)&lt;br&gt;Provider chosen in Sprint 4" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#F7F7F7;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="1260" y="430" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;font color=&quot;#555555&quot;&gt;«external»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Email Service&lt;/b&gt;&lt;br&gt;SMTP or email API; delivers to&lt;br&gt;@pitt.edu inboxes (FR12, FR13)" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#F7F7F7;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="1260" y="670" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;• Pages and forms: sign up / sign in, post ride, search, ride details, my rides, join requests, group chat, ride completed (FR1–FR11, FR13, FR16)&lt;br&gt;• Prefilled defaults and input checks for the post-ride form (NFR4); accessible, server-rendered HTML (NFR5); map embed and Open-in-Uber/Lyft link&lt;br&gt;&lt;i&gt;Shows data from: User, Ride, RideOption, RideRequest, Message, Location (owns no AOM class)&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="70" y="195" width="1100" height="98" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Accounts &amp;amp; Verification&lt;/b&gt;&lt;br&gt;• Sign-up with @pitt.edu check (US1)&lt;br&gt;• Sign-in / sign-out sessions (US19)&lt;br&gt;• Argon2id password hashing (NFR6)&lt;br&gt;• One-time verification link, 1 h (US2)&lt;br&gt;• Profile, notification settings (US3)&lt;br&gt;&lt;i&gt;Classes: User, University&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="90" y="430" width="240" height="155" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Ride Coordination&lt;/b&gt;&lt;br&gt;• Join requests: ask, accept, decline,&lt;br&gt;   withdraw (US10, US11, US13)&lt;br&gt;• Seat and luggage limits, auto-decline,&lt;br&gt;   full / open status (US14)&lt;br&gt;• Group chat for the ride (US15)&lt;br&gt;&lt;i&gt;Classes: RideRequest, Message&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="370" y="430" width="250" height="155" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Ride Management&lt;/b&gt;&lt;br&gt;• Post, change, cancel rides (US4, 5, 18)&lt;br&gt;• Search by place, date, window (US7)&lt;br&gt;• Estimated fare and share (US8),&lt;br&gt;   final share after the ride (US17)&lt;br&gt;• My rides (US12); 30-day rule (NFR7)&lt;br&gt;&lt;i&gt;Classes: RideBoard, Ride, RideOption&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="660" y="430" width="255" height="155" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Places &amp;amp; Maps&lt;/b&gt;&lt;br&gt;• Landmark list by kind (NFR7)&lt;br&gt;• Distance between two places&lt;br&gt;• Map data from Map Service (US9)&lt;br&gt;• Pickup / drop-off coordinates&lt;br&gt;   for the Uber / Lyft link (US6)&lt;br&gt;&lt;i&gt;Classes: Location&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="955" y="430" width="230" height="155" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;• Builds every outbound email: FR12&lt;br&gt;   ride events and verification links&lt;br&gt;• Outbox; sends within 60 s (NFR2)&lt;br&gt;• Reminder 2 h before departure (US16)&lt;br&gt;• Honors notification preferences&lt;br&gt;&lt;i&gt;Classes: Notification&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="370" y="645" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Data Storage&lt;/b&gt;&lt;br&gt;• Stores every AOM class through the ORM (SQLite in development;&lt;br&gt;   production database chosen in Sprint 4)&lt;br&gt;• Transactions for seat and luggage updates, so a ride is never overbooked (US14)&lt;br&gt;• Scheduled deletion of trip locations 30 days after the ride (NFR7)&lt;br&gt;&lt;i&gt;Persistent form of all nine AOM classes&lt;/i&gt;" style="shape=component;align=left;spacingLeft=8;spacingRight=30;spacingTop=4;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;jettyWidth=10;jettyHeight=5;" vertex="1" parent="1"><mxGeometry x="370" y="910" width="530" height="120" as="geometry"/></mxCell>
