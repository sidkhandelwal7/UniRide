# Copy this file to .env (same folder as manage.py) and change the values.
# .env is ignored by git, so real keys and passwords never get committed.

# Any long random text works on a laptop.
DJANGO_SECRET_KEY=change-me-to-any-long-random-text

# True while developing. Never True on a real server.
DJANGO_DEBUG=True

# Email (US2 verification links)
# Leave EMAIL_HOST empty and emails are printed in the terminal (the default).
# To send real emails, for example for the Pitt inbox test in issue #38, fill
# these in. Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, your
# Gmail address as EMAIL_HOST_USER, and a Gmail app password (not your normal
# password) as EMAIL_HOST_PASSWORD. Use the same Gmail address in DEFAULT_FROM_EMAIL.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="UniRide <noreply@uniride.local>"
